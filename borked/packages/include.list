# Bootable skeleton. One package or @group per line.
# Edit this file, then run `just lock`. Do not hand-edit packages/lock.
@core
kernel
kernel-modules
linux-firmware
microcode_ctl
# AMD microcode. Intel ships as microcode_ctl. Both stay in the image.
amd-ucode-firmware
grub2-efi-x64
shim-x64
efibootmgr
btrfs-progs
NetworkManager
pipewire
wireplumber
selinux-policy-targeted
# cosmic-greeter's PAM stack needs pam_systemd.so. Weak deps are off.
systemd-pam
# The installer writes /etc/localtime from this.
tzdata
# cosmic-initial-setup drops C.UTF-8, so the language page is empty
# without a real locale. English is the one the image ships.
glibc-langpack-en
# The created user is in wheel.
sudo
# cosmic-store lists Fedora apps through PackageKit. Weak deps are off,
# so the desktop group does not pull this in, and the store stays on
# Loading. appstream-data is the catalog. The portal service is what
# flatpak and the file dialogs talk to; the COSMIC backend is already
# in the desktop group.
PackageKit
appstream-data
xdg-desktop-portal
p11-kit-server
@cosmic-desktop
borked-release
borked-repos
borked-defaults
