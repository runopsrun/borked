#!/bin/bash
# Installed as /usr/bin/borked-selfcheck by borked-release.
# Qemu boots it with systemd.run=/usr/bin/borked-selfcheck.
set -u

RESULT=/run/borked-selfcheck-result
: >"$RESULT" 2>/dev/null || true
fail=0

say() {
    local line="borked-selfcheck: $*"
    printf '%s\n' "$line"
    printf '%s\n' "$line" >>"$RESULT" 2>/dev/null || true
    if [[ -w /dev/kmsg ]]; then
        printf '<6>%s\n' "$line" >/dev/kmsg 2>/dev/null || true
    fi
    if [[ -c /dev/ttyS0 ]]; then
        printf '%s\n' "$line" >/dev/ttyS0 2>/dev/null || true
    fi
}

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
fi
if [[ "${ID:-}" == "borked" ]]; then
    say "ok id=borked"
else
    say "FAIL id=${ID:-missing}"
    fail=1
fi

if [[ -f /etc/selinux/config ]] && grep -q '^SELINUX=enforcing$' /etc/selinux/config; then
    say "ok selinux-config=enforcing"
else
    say "FAIL selinux-config"
    fail=1
fi

if compgen -G /etc/selinux/targeted/policy/policy.* >/dev/null; then
    say "ok selinux-policy-present"
else
    say "FAIL selinux-policy-missing"
    fail=1
fi

enf="$(getenforce 2>/dev/null || echo unknown)"
say "getenforce=${enf}"
if [[ "$enf" != "Enforcing" ]]; then
    say "FAIL getenforce=${enf}"
    fail=1
fi

if systemctl is-enabled cosmic-greeter.service >/dev/null 2>&1; then
    say "ok greeter-enabled"
else
    say "FAIL greeter-not-enabled"
    fail=1
fi

if systemctl is-enabled cosmic-greeter-daemon.service >/dev/null 2>&1; then
    say "ok greeter-daemon-enabled"
else
    say "FAIL greeter-daemon-not-enabled"
    fail=1
fi

def="$(systemctl get-default 2>/dev/null || true)"
if [[ "$def" == "graphical.target" ]]; then
    say "ok default-target=graphical.target"
else
    say "FAIL default-target=${def:-missing}"
    fail=1
fi

flatpak_cfg=/var/lib/flatpak/repo/config
panel_entries=/usr/share/cosmic/com.system76.CosmicPanel/v1/entries
if [[ -f "$panel_entries" ]] && grep -qx '\["Dock"\]' "$panel_entries"; then
    say "ok panel-entries=dock"
else
    say "FAIL panel-entries"
    fail=1
fi

if rpm -q quickshell >/dev/null 2>&1 \
    && [[ -f /usr/share/borked/quickshell/shell.qml ]] \
    && [[ -e /usr/lib/systemd/user/cosmic-session.target.wants/borked-quickshell.service ]]
then
    say "ok quickshell"
else
    say "FAIL quickshell"
    fail=1
fi

if rpm -q bluez >/dev/null 2>&1 \
    && rpm -q upower >/dev/null 2>&1 \
    && systemctl is-enabled bluetooth.service >/dev/null 2>&1
then
    say "ok status-services"
else
    say "FAIL status-services"
    fail=1
fi

if rpm -q hyprland >/dev/null 2>&1 \
    && [[ -f /usr/share/wayland-sessions/hyprland.desktop ]] \
    && [[ -f /usr/share/wayland-sessions/cosmic.desktop ]] \
    && [[ -f /usr/share/borked/hypr/hyprland.conf ]]
then
    say "ok desktop-sessions"
else
    say "FAIL desktop-sessions"
    fail=1
fi

if [[ -f "$flatpak_cfg" ]] && awk '
    /^\[remote "flathub"\]$/ { remote = "flathub"; next }
    /^\[remote "cosmic"\]$/ { remote = "cosmic"; next }
    /^\[/ { remote = "" }
    remote == "flathub" && $0 == "url=https://dl.flathub.org/repo/" { flathub_url = 1 }
    remote == "flathub" && $0 == "gpg-verify=true" { flathub_gpg = 1 }
    remote == "cosmic" && $0 == "url=https://apt.pop-os.org/cosmic/" { cosmic_url = 1 }
    remote == "cosmic" && $0 == "gpg-verify=true" { cosmic_gpg = 1 }
    END { exit (flathub_url && flathub_gpg && cosmic_url && cosmic_gpg) ? 0 : 1 }
' "$flatpak_cfg"; then
    say "ok flatpak-remotes"
else
    say "FAIL flatpak-remotes"
    fail=1
fi

list=/usr/share/borked/exclude.list
if [[ ! -f "$list" ]]; then
    say "FAIL exclude-list-missing"
    fail=1
else
    while IFS= read -r name || [[ -n "$name" ]]; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        # shellcheck disable=SC2086
        hits="$(rpm -qa --qf '%{NAME}\n' $name 2>/dev/null || true)"
        if [[ -n "$hits" ]]; then
            say "FAIL present ${hits//$'\n'/,}"
            fail=1
        else
            say "ok absent $name"
        fi
    done <"$list"
fi

if mountpoint -q /boot/efi 2>/dev/null; then
    cp "$RESULT" /boot/efi/borked-selfcheck.txt 2>/dev/null || true
fi

if [[ "$fail" -eq 0 ]]; then
    say PASS
    exit 0
fi
say FAIL
exit 1
